{
  "name": "dsh-feiyu-image",
  "version": "0.2.0",
  "description": "给大肥鱼一个相机：火山方舟 Seedream 5.0 生图，支持用三视图当参考图锁住角色形象，出图存本地、可直接发到 QQ。",
  "type": "module",
  "license": "MIT",
  "engines": {
    "node": ">=22"
  },
  "keywords": [
    "dsh",
    "dsh-plugin",
    "deepseek-harness",
    "image",
    "wanx",
    "bailian",
    "companion"
  ],
  "author": "Vansnc",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Vansnc/dsh-feiyu-image.git"
  },
  "homepage": "https://github.com/Vansnc/dsh-feiyu-image#readme",
  "bugs": {
    "url": "https://github.com/Vansnc/dsh-feiyu-image/issues"
  },
  "main": "lib/index.js",
  "exports": {
    ".": "./lib/index.js",
    "./cordis.patch.yml": "./cordis.patch.yml",
    "./package.json": "./package.json"
  },
  "files": [
    "lib",
    "cordis.patch.yml",
    "README.md",
    "CHANGELOG.md",
    "LICENSE"
  ],
  "publishConfig": {
    "access": "public"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    }
  }
}